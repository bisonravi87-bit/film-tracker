NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Solo servidor: permite cachear películas/directores de TMDB en la base de datos
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Token "API Read Access Token" de TMDB
TMDB_API_KEY=your_tmdb_read_access_token

# Para los scripts de siembra (npm run seed:all), misma información en nombres sin el prefijo público:
SUPABASE_URL=your_supabase_url
